# ── Anthropic ────────────────────────────────────────────────────────────────
# Required: Anthropic API key for Claude (challenge + profile generation)
# Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ── Clerk (authentication) ────────────────────────────────────────────────────
# Required for user accounts, profile, and discover features
# Get yours at https://dashboard.clerk.com/
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Optional: customize Clerk redirect URLs (defaults work for local dev)
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
# NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ── Vercel Postgres (Neon) ────────────────────────────────────────────────────
# Required for saving game sessions, profiles, and matching
# Automatically set when you link a Vercel Postgres database in the Vercel dashboard
# For local dev: copy from your Vercel project's .env.local (Settings → Environment Variables)
POSTGRES_URL=postgres://...
POSTGRES_URL_NON_POOLING=postgres://...
POSTGRES_USER=...
POSTGRES_HOST=...
POSTGRES_PASSWORD=...
POSTGRES_DATABASE=...
